              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.variables.set(\"name\", \"Nuevo platillo\");",
                  "pm.variables.set(\"menuType\", \"PON_AQUI_UN_UUID_MENUTYPE\");",
                  "pm.variables.set(\"availableDate\", new Date().getTime());",
                  "pm.variables.set(\"cost\", \"25\");",
                  "pm.variables.set(\"description\", \"Descripcion prueba\");",
                  "pm.variables.set(\"availableDishes\", \"10\");"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtAdmin}}" },
              { "key": "Authorization", "value": "Bearer {{jwtChef}}", "disabled": true },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"menuType\": \"{{menuType}}\",\n  \"availableDate\": \"{{availableDate}}\",\n  \"cost\": \"{{cost}}\",\n  \"description\": \"{{description}}\",\n  \"availableDishes\": \"{{availableDishes}}\"\n}"
