{
  "info": {
    "_postman_id": "48159966-ordenaris-api",
    "name": "Restaurante API Final",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "jwtAdmin", "value": "" },
    { "key": "jwtChef", "value": "" },
    { "key": "host", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var r = pm.response.json();",
                  "pm.collectionVariables.set(\"jwtAdmin\", r.access_token);",
                  "console.log(\"TOKEN ADMIN actualizado:\", r.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}"
            },
            "url": "{{host}}/api/login"
          }
        },
        {
          "name": "Login Chef",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var r = pm.response.json();",
                  "pm.collectionVariables.set(\"jwtChef\", r.access_token);",
                  "console.log(\"TOKEN CHEF actualizado:\", r.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"chef\",\n  \"password\": \"chef\"\n}"
            },
            "url": "{{host}}/api/login"
          }
        }
      ]
    },

    {
      "name": "Menu",
      "item": [
        {
          "name": "Tipo Menu",
          "item": [

            {
              "name": "Registrar",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "pm.variables.set(\"name\", \"NuevoTipo\");",
                      "pm.variables.set(\"parent\", \"\");"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{jwtAdmin}}"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{jwtChef}}",
                    "disabled": true
                  },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"{{name}}\",\n  \"parentType\": \"{{parent}}\"\n}"
                },
                "url": "{{host}}/api/menu/type/new"
              }
            },

            {
              "name": "Listar",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{jwtAdmin}}"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{jwtChef}}",
                    "disabled": true
                  }
                ],
                "url": "{{host}}/api/menu/type/list"
              }
            },

            {
              "name": "Paginar",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{jwtAdmin}}" },
                  { "key": "Authorization", "value": "Bearer {{jwtChef}}", "disabled": true }
                ],
                "url": {
                  "raw": "{{host}}/api/menu/type/view?page=1&orderColumn=name&order=asc&max=10",
                  "host": ["{{host}}"],
                  "path": ["api", "menu", "type", "view"],
                  "query": [
                    { "key": "page", "value": "1" },
                    { "key": "orderColumn", "value": "name" },
                    { "key": "order", "value": "asc" },
                    { "key": "max", "value": "10" }
                  ]
                }
              }
            },

            {
              "name": "Ver Información",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "pm.variables.set(\"uuid\", \"PON_AQUI_UN_UUID_REAL\");"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{jwtAdmin}}" },
                  { "key": "Authorization", "value": "Bearer {{jwtChef}}", "disabled": true }
                ],
                "url": "{{host}}/api/menu/type/{{uuid}}/info"
              }
            },

            {
              "name": "Editar",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "pm.variables.set(\"uuid\", \"PON_AQUI_UUID_EDITAR\");",
                      "pm.variables.set(\"new_name\", \"NombreEditado\");"
                    ]
                  }
                }
              ],
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{jwtAdmin}}" },
                  { "key": "Authorization", "value": "Bearer {{jwtChef}}", "disabled": true },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"{{new_name}}\"\n}"
                },
                "url": "{{host}}/api/menu/type/{{uuid}}/edit"
              }
            },

            {
              "name": "Activar",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "pm.variables.set(\"uuid\", \"PON_UUID_ACTIVAR\");"
                    ]
                  }
                }
              ],
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{jwtAdmin}}" },
                  { "key": "Authorization", "value": "Bearer {{jwtChef}}", "disabled": true }
                ],
                "url": "{{host}}/api/menu/type/{{uuid}}/activate"
              }
            },

            {
              "name": "Desactivar",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "pm.variables.set(\"uuid\", \"PON_UUID_DESACTIVAR\");"
                    ]
                  }
                }
              ],
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{jwtAdmin}}" },
                  { "key": "Authorization", "value": "Bearer {{jwtChef}}", "disabled": true }
                ],
                "url": "{{host}}/api/menu/type/{{uuid}}/deactivate"
              }
            },

            {
              "name": "Eliminar",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "pm.variables.set(\"uuid\", \"PON_UUID_ELIMINAR\");"
                    ]
                  }
                }
              ],
              "request": {
                "method": "DELETE",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{jwtAdmin}}" },
                  { "key": "Authorization", "value": "Bearer {{jwtChef}}", "disabled": true }
                ],
                "url": "{{host}}/api/menu/type/{{uuid}}/delete"
              }
            }

          ]
        }
      ]
    },

    {
      "name": "Platillos",
      "item": [

        {
          "name": "Registrar",
          "event": [
