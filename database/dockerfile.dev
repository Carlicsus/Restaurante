FROM mysql:5.7

ARG MYSQL_DATABASE_DEV
ARG MYSQL_DATABASE_TEST
ARG MYSQL_DATABASE_PROD
ARG MYSQL_USER

ENV MYSQL_DATABASE_DEV=$MYSQL_DATABASE_DEV
ENV MYSQL_DATABASE_TEST=$MYSQL_DATABASE_TEST
ENV MYSQL_DATABASE_PROD=$MYSQL_DATABASE_PROD
ENV MYSQL_USER=$MYSQL_USER

COPY ./dev/init.sh /init.sh

RUN chmod +x /init.sh

RUN /init.sh
